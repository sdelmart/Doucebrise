<!DOCTYPE html>
<html>
<head>
    <title>{{ title }}</title>
</head>
<body>
    <h1>{{ article.title }}</h1>
    <p>Par {{ article.author }} le {{ article.date|date('d/m/Y') }}</p>
    <div>{{ article.content }}</div>

    <h2>Commentaires ({{ comments|length }} commentaires trouvés)</h2>
    <ul>
        {% for comment in comments %}
            <li><strong>{{ comment.author }}</strong> : {{ comment.message }}</li>
        {% endfor %}
    </ul>

</body>
</html>
